# Neon / Postgres
DATABASE_URL=postgresql://usuario:password@host.neon.tech/dbname?sslmode=require

# platform.claude.com -> API Keys
ANTHROPIC_API_KEY=sk-ant-...

# Nombre del negocio que aparece en el encabezado
NEXT_PUBLIC_EMPRESA=Brew Wines

# Acceso al tablero. Cambia AMBOS antes de publicar.
# SESSION_SECRET: cadena larga y aleatoria. Genérala con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_PASSWORD=cambia-esta-contrasena
SESSION_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria

# Tenant activo
TENANT_ID=brewwines

# Precios de la API para el reporte de costos (dólares por millón de tokens).
# Consulta los vigentes en:
#   https://platform.claude.com/docs/en/about-claude/models/overview
PRECIO_ENTRADA_MTOK=
PRECIO_SALIDA_MTOK=
PRECIO_CACHE_ESCRITURA_MTOK=
PRECIO_CACHE_LECTURA_MTOK=
TIPO_CAMBIO_USD=20
